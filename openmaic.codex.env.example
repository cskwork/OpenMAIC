# Copy to .env.local; replace each REPLACE_WITH_RANDOM_64_HEX with a separate
# value from: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CODEX_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_64_HEX
QWEN_TTS_TOKEN=REPLACE_WITH_RANDOM_64_HEX
OPENMAIC_SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX

# This launcher uses its own loopback-only database and volume.
OPENMAIC_DB_PORT=57439
DATABASE_URL=postgres://openmaic:openmaic-dev@127.0.0.1:57439/openmaic
OWNER_SINGLE_USER=true
OPENMAIC_AGENT_RUNTIME_ENABLED=true
NEXT_PUBLIC_PRO_WORKBENCH_ENABLED=true
CODEX_BRIDGE_PORT=57440
QWEN_TTS_PORT=57441
OPENMAIC_PORT=3000
TTS_REQUEST_TIMEOUT_MS=180000

# Existing offline Qwen3-TTS-12Hz-1.7B-Base weights and your original voice.
# Replace these paths; no model weights or voice assets are in this fork.
QWEN_TTS_MODEL_PATH=/absolute/path/to/qwen3-tts-base
QWEN_TTS_VOICE_PROFILE=/absolute/path/to/announcer-female-calm-ko.json
QWEN_TTS_DEVICE=mps
